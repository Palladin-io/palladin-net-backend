{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Hangfire": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-dev-hangfire;Username=postgres;Password=mysecretpassword"
  },
  "MassTransit": {
    "RabbitMq": {
      "VirtualHost": "/",
      "Host": "localhost",
      "User": "guest",
      "Password": "guest",
      "Port": "5672",
      "UseAmqps": "false"
    },
    "EnableDelayedMessageScheduler": true
  },
  "Modules": {
    "PublicAssetCatalog": {
      "ServiceAuth": { "SigningSecret": "development-public-asset-service-secret" },
      "Persistence": { "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-dev-public-assets;Username=postgres;Password=mysecretpassword", "AutoMigration": true },
      "Storage": { "BucketName": "palladin-local-public-assets", "Region": "eu-west-1", "Endpoint": "http://localhost:4566", "PublicBaseUrl": "http://localhost:4566/palladin-local-public-assets", "AccessKey": "test", "SecretKey": "test", "ForcePathStyle": true, "MaximumBytes": 1048576 }
    },
    "Identity": {
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-dev-identity;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      },
      "Jwt": {
        "Secret": "super-secret-dev-key-that-is-at-least-32-bytes-long!",
        "Issuer": "palladin-dev",
        "Audience": "palladin-dev",
        "AccessTokenExpiryMinutes": 60,
        "RefreshTokenExpiryDays": 365,
        "RefreshTokenRotationThresholdDays": 7
      },
      "Google": {
        "ClientId": "1006466869105-3j8tlokqhsej6cnu0tcvohb7bgd13s9v.apps.googleusercontent.com"
      }
    },
    "Vault": {
      "AssetStorage": { "BucketName": "palladin-local", "Region": "eu-west-1", "Endpoint": "http://localhost:4566", "AccessKey": "test", "SecretKey": "test", "ForcePathStyle": true, "DownloadUrlLifetimeMinutes": 1 },
      "Creation": {
        "ChallengeTtlSeconds": 600
      },
      "History": {
        "MaximumVersions": 100,
        "MaximumAgeDays": 365,
        "DefaultPageSize": 20,
        "MaximumPageSize": 100
      },
      "EntryLifecycle": {
        "RecentlyDeletedDays": 30,
        "Enabled": true,
        "Expression": "17 */6 * * *",
        "BatchSize": 100
      },
      "PurgeLedger": {
        "Enabled": false
      },
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-dev-vault;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      }
    },
    "Agents": {
      "PublicAssetCatalog": { "BaseUrl": "http://localhost:5000" },
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-dev-agents;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      },
      "ApiKeyCache": {
        "Duration": "00:05:00"
      }
    },
    "Notification": {
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-dev-notification;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      }
    },
    "Audit": {
      "ExportStorage": { "BucketName": "palladin-local", "Region": "eu-west-1", "Endpoint": "http://localhost:4566", "AccessKey": "test", "SecretKey": "test", "ForcePathStyle": true, "DownloadUrlLifetimeMinutes": 1 },
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-dev-audit;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      }
    },
    "Search": {
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-dev-search;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      }
    }
  },
  "Ai": {
    "EngineeringPlatform": {
      "Langfuse": {
        "Pk": "",
        "Sk": ""
      }
    },
    "SemanticKernel": {
      "DefaultProvider": "openai",
      "GenericProviders": {
        "openai": {
          "Url": "https://api.openai.com/v1",
          "Key": "",
          "DefaultModelId": "gpt-4o-mini-2024-07-18"
        }
      }
    }
  }
}
