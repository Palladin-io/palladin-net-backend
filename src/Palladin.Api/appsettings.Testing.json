{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Hangfire": {
    "Enabled": false,
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=jb-automatictests-palladin-hangfire;Username=postgres;Password=mysecretpassword"
  },
  "MassTransit": {
    "RabbitMq": {
      "VirtualHost": "/",
      "Host": "localhost",
      "User": "guest",
      "Password": "guest",
      "Port": "5672",
      "UseAmqps": "false"
    },
    "EnableDelayedMessageScheduler": true
  },
  "Modules": {
    "PublicAssetCatalog": {
      "ServiceAuth": { "SigningSecret": "testing-public-asset-service-secret" },
      "Persistence": { "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-test-public-assets;Username=postgres;Password=mysecretpassword", "AutoMigration": true },
      "Storage": { "BucketName": "palladin-test-public-assets", "Region": "eu-central-1", "Endpoint": "http://localhost:4566", "PublicBaseUrl": "http://localhost:4566/palladin-test-public-assets", "AccessKey": "test", "SecretKey": "test", "ForcePathStyle": true, "MaximumBytes": 1048576 }
    },
    "Identity": {
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-test-identity;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      },
      "Jwt": {
        "Secret": "test-secret-key-that-is-at-least-32-bytes-long!!",
        "Issuer": "palladin-test",
        "Audience": "palladin-test",
        "AccessTokenExpiryMinutes": 60,
        "RefreshTokenExpiryDays": 365,
        "RefreshTokenRotationThresholdDays": 7
      },
      "Google": {
        "ClientId": "test-google-client-id.apps.googleusercontent.com"
      },
      "Waitlist": {
        "Enabled": true,
        "TokenTtlHours": 24,
        "ResendCooldownMinutes": 5,
        "VerificationUrlBase": "http://localhost:5000/api/waitlist/verify",
        "VerifiedRedirectUrl": "https://palladin.io/waitlist/confirmed",
        "FailedRedirectUrl": "https://palladin.io/waitlist/invalid"
      },
      "PasswordAuth": {
        "MemoryKib": 8192,
        "Iterations": 1,
        "DegreeOfParallelism": 1,
        "HashLength": 32,
        "ServerSaltLength": 16,
        "PseudoSaltLength": 16,
        "EnumerationSecret": "test-enumeration-secret-32-bytes-minimum!!"
      },
      "Totp": {
        "Issuer": "Palladin",
        "SecretSizeBytes": 20,
        "RecoveryCodeCount": 10,
        "VerificationWindowSteps": 1,
        "ChallengeTtlMinutes": 5
      },
      "LoginThrottle": {
        "MaxAttempts": 4,
        "WindowMinutes": 5,
        "LockoutMinutes": 15,
        "RateLimitWindowSeconds": 60,
        "LoginIpPermitLimit": 10000,
        "LoginAccountPermitLimit": 10000,
        "TotpIpPermitLimit": 10000,
        "TotpAccountPermitLimit": 10000,
        "ConcurrencyRetryLimit": 64
      },
      "CleanupLoginRateLimitBucketsJob": {
        "Enabled": true,
        "Expression": "*/5 * * * *",
        "RetentionMinutes": 15,
        "BatchSize": 500
      },
      "EmailVerification": {
        "TokenTtlMinutes": 60,
        "ResendCooldownMinutes": 2,
        "VerificationUrlBase": "http://localhost:5173/verify-email",
        "GateEnabled": true
      },
      "OrganizationInvitations": {
        "TokenTtlHours": 72,
        "ResendCooldownSeconds": 60,
        "AcceptanceUrlBase": "http://localhost:5173/invitations/accept"
      }
    },
    "Vault": {
      "AssetStorage": { "BucketName": "palladin-test", "Region": "eu-west-1", "Endpoint": "http://localhost:4566", "AccessKey": "test", "SecretKey": "test", "ForcePathStyle": true, "DownloadUrlLifetimeMinutes": 1 },
      "Creation": {
        "ChallengeTtlSeconds": 600
      },
      "PurgeLedger": {
        "Enabled": false
      },
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-test-vault;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      }
    },
    "Agents": {
      "PublicAssetCatalog": { "BaseUrl": "http://localhost:5000" },
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-test-agents;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      },
      "ApiKeyCache": {
        "Duration": "00:05:00"
      }
    },
    "Notification": {
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-test-notification;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      },
      "Ses": {
        "Region": "eu-west-1",
        "AccessKey": "",
        "SecretKey": "",
        "ConfigurationSetName": "",
        "FromAddress": "",
        "FromName": "Palladin",
        "EventsQueueUrl": ""
      },
      "EmailBranding": {
        "AppName": "Palladin",
        "BaseUrl": "https://palladin.io",
        "SupportEmail": "support@palladin.io",
        "MobileAppUrl": "https://palladin.io/#features",
        "BrowserExtensionUrl": "https://palladin.io/#features",
        "LogoUrl": ""
      }
    },
    "Audit": {
      "ExportStorage": { "BucketName": "palladin-test", "Region": "eu-west-1", "Endpoint": "http://localhost:4566", "AccessKey": "test", "SecretKey": "test", "ForcePathStyle": true, "DownloadUrlLifetimeMinutes": 1 },
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-test-audit;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      }
    },
    "Search": {
      "Persistence": {
        "ConnectionString": "Host=127.0.0.1;Port=5432;Database=palladin-test-search;Username=postgres;Password=mysecretpassword",
        "AutoMigration": true
      }
    }
  },
  "Ai": {
    "EngineeringPlatform": {
      "Langfuse": {
        "Pk": "",
        "Sk": ""
      }
    },
    "SemanticKernel": {
      "DefaultProvider": "openai",
      "GenericProviders": {
        "openai": {
          "Url": "https://api.openai.com/v1",
          "Key": "sk-test-dummy-key-for-testing-only",
          "DefaultModelId": "gpt-4o-mini-2024-07-18"
        }
      }
    }
  }
}
