{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "Expression": "EndsWith(RequestPath, '/healthz') and @l <> 'Error'"
        }
      }
    ]
  },
  "AllowedHosts": "api.palladin.io",
  // Behind a proxy set TrustForwardedHeaders=true + KnownProxies/KnownNetworks, else forwarded IPs are spoofable. See release-checklist.
  "Networking": {
    "TrustForwardedHeaders": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Modules": {
    "PublicAssetCatalog": {
      "ServiceAuth": { "SigningSecret": "" },
      "Persistence": { "ConnectionString": "", "AutoMigration": true },
      "Storage": { "BucketName": "", "Region": "eu-central-1", "PublicBaseUrl": "https://assets.palladin.io", "MaximumBytes": 1048576 }
    },
    "Identity": {
      "Persistence": {
        "ConnectionString": "",
        "AutoMigration": true
      },
      "Jwt": {
        "Secret": "",
        "Issuer": "palladin",
        "Audience": "palladin",
        "AccessTokenExpiryMinutes": 15,
        "RefreshTokenExpiryDays": 365,
        "RefreshTokenRotationThresholdDays": 7
      },
      "Google": {
        "ClientId": ""
      },
      "Waitlist": {
        "Enabled": false,
        "TokenTtlHours": 24,
        "ResendCooldownMinutes": 5,
        "VerificationUrlBase": "",
        "VerifiedRedirectUrl": "",
        "FailedRedirectUrl": ""
      },
      "PasswordAuth": {
        "MemoryKib": 19456,
        "Iterations": 2,
        "DegreeOfParallelism": 1,
        "HashLength": 32,
        "ServerSaltLength": 16,
        "PseudoSaltLength": 16,
        "EnumerationSecret": ""
      },
      "Totp": {
        "Issuer": "Palladin",
        "SecretSizeBytes": 20,
        "RecoveryCodeCount": 10,
        "VerificationWindowSteps": 1,
        "ChallengeTtlMinutes": 5
      },
      "LoginThrottle": {
        "MaxAttempts": 4,
        "WindowMinutes": 5,
        "LockoutMinutes": 15,
        "RateLimitWindowSeconds": 60,
        "LoginIpPermitLimit": 30,
        "LoginAccountPermitLimit": 10,
        "TotpIpPermitLimit": 30,
        "TotpAccountPermitLimit": 10,
        "ConcurrencyRetryLimit": 64
      },
      "CleanupLoginRateLimitBucketsJob": {
        "Enabled": true,
        "Expression": "*/5 * * * *",
        "RetentionMinutes": 15,
        "BatchSize": 500
      },
      "CleanupSharedUnlockOperationsJob": {
        "Enabled": true,
        "Expression": "*/5 * * * *",
        "BatchSize": 500
      },
      "EmailVerification": {
        "TokenTtlMinutes": 60,
        "ResendCooldownMinutes": 2,
        "VerificationUrlBase": "",
        "GateEnabled": true
      },
      "OrganizationInvitations": {
        "TokenTtlHours": 72,
        "ResendCooldownSeconds": 60,
        "AcceptanceUrlBase": ""
      }
    },
    "Vault": {
      "AssetStorage": { "BucketName": "", "Region": "eu-west-1", "DownloadUrlLifetimeMinutes": 1 },
      "Creation": {
        "ChallengeTtlSeconds": 600
      },
      "History": {
        "MaximumVersions": 100,
        "MaximumAgeDays": 365,
        "DefaultPageSize": 20,
        "MaximumPageSize": 100
      },
      "EntryLifecycle": {
        "RecentlyDeletedDays": 30,
        "Enabled": true,
        "Expression": "17 */6 * * *",
        "BatchSize": 100
      },
      "PurgeLedger": {
        "Enabled": true,
        "BucketName": "",
        "Region": "eu-west-1",
        "ObjectPrefix": "vault-entry-purge-ledger",
        "KeyParameterPrefix": "",
        "CurrentKeyVersion": 1,
        "RetentionDays": 120
      },
      "Persistence": {
        "ConnectionString": "",
        "AutoMigration": true
      }
    },
    "Agents": {
      "PublicAssetCatalog": { "BaseUrl": "http://localhost:5000" },
      "Persistence": {
        "ConnectionString": "",
        "AutoMigration": true
      },
      "ApiKeyCache": {
        "Duration": "00:05:00"
      },
      "Pairing": {
        "ApprovalUrlBase": "",
        "Lifetime": "00:30:00",
        "PollIntervalMilliseconds": 2000
      },
      "CleanupAgentPairingsJob": {
        "Enabled": true,
        "Expression": "*/1 * * * *",
        "TerminalRetentionMinutes": 15,
        "BatchSize": 500
      },
      "FormDiscoveryMaps": {
        "MaximumDefinitionBytes": 65536,
        "MaximumLoginUrlBytes": 2048,
        "MaximumProviderLength": 64,
        "MaximumJsonDepth": 32,
        "MaximumSteps": 8,
        "MaximumFields": 16,
        "MaximumFieldIdLength": 128,
        "MaximumSelectorBytes": 1024,
        "MaximumCookieOverlays": 4,
        "MaximumSelectorsPerOverlay": 8,
        "MinimumWaitTimeoutMilliseconds": 100,
        "MaximumWaitTimeoutMilliseconds": 60000,
        "MaximumLookupRevisions": 20
      },
      "Signature": {
        "ClockSkewSeconds": 300,
        "NonceTtlSeconds": 600
      }
    },
    "Notification": {
      "Persistence": {
        "ConnectionString": "",
        "AutoMigration": true
      },
      "Firebase": {
        "ServiceAccountJsonPath": "",
        "WebClickBaseUrl": "https://palladin.io"
      },
      "Ses": {
        "Region": "eu-west-1",
        "AccessKey": "",
        "SecretKey": "",
        "ConfigurationSetName": "",
        "FromAddress": "",
        "FromName": "Palladin",
        "EventsQueueUrl": ""
      },
      "EmailBranding": {
        "AppName": "Palladin",
        "BaseUrl": "https://palladin.io",
        "SupportEmail": "support@palladin.io",
        "MobileAppUrl": "https://palladin.io/#features",
        "BrowserExtensionUrl": "https://palladin.io/#features",
        "LogoUrl": "https://palladin.io/logo.png"
      }
    },
    "Audit": {
      "ExportStorage": { "BucketName": "", "Region": "eu-west-1", "DownloadUrlLifetimeMinutes": 1 },
      "Persistence": {
        "ConnectionString": "",
        "AutoMigration": true
      }
    }
  }
}
