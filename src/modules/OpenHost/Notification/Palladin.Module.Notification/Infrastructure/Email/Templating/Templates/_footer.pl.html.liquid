            </td>
          </tr>
          <tr>
            <td style="padding:24px 32px;background:#fafafa;border-top:1px solid #eeeeee;font-size:12px;line-height:1.6;color:#8a8a8a">
              <p style="margin:0 0 4px">{{ appName }} — <a href="{{ baseUrl }}" style="color:#8a8a8a">{{ baseUrl }}</a></p>
              <p style="margin:0 0 4px">Potrzebujesz pomocy? Napisz na <a href="mailto:{{ supportEmail }}" style="color:#8a8a8a">{{ supportEmail }}</a>.</p>
              {% if optOutUrl %}<p style="margin:0 0 4px">Nie chcesz otrzymywać tych wiadomości? <a href="{{ optOutUrl }}" style="color:#8a8a8a">Zrezygnuj tutaj</a>.</p>{% endif %}
              <p style="margin:0;color:#b0b0b0">&copy; {{ year }} {{ appName }}. Wszelkie prawa zastrzeżone.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
