<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1a1a1a">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 0">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden">
          <tr>
            <td style="background:#F8FAFC;padding:17px 32px;border-bottom:1px solid #E7E9ED">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  {% if logoUrl %}<td width="26" style="width:26px;vertical-align:middle"><img src="{{ logoUrl }}" alt="" role="presentation" width="26" height="26" style="display:block;border:0;width:26px;height:26px"></td><td width="10" style="width:10px"></td>{% endif %}
                  <td style="vertical-align:middle"><div style="font-size:17px;font-weight:800;letter-spacing:-0.01em;line-height:26px;color:#0C0E12">{{ appName }}<span style="color:#EB4747">.io</span></div></td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;font-size:15px;line-height:1.6">
