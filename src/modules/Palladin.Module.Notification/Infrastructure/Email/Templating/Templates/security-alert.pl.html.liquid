{% include '_header.html.liquid' %}
<h1 style="margin:0 0 16px;font-size:20px;font-weight:700">{{ eventTitle }}</h1>
<p style="margin:0 0 16px">Cześć{% if name %} {{ name }}{% endif %}, informujemy o aktywności na Twoim koncie {{ appName }}.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 20px;background:#fbeaea;border:1px solid #f3caca;border-radius:8px">
  <tr><td style="padding:16px;font-size:14px;color:#7a1f1f">
    <p style="margin:0 0 8px">{{ eventDescription }}</p>
    {% if occurredAt %}<p style="margin:0;font-size:13px;color:#a05050">Kiedy: {{ occurredAt }}</p>{% endif %}
  </td></tr>
</table>
<p style="margin:0 0 16px">Jeśli to byłeś Ty, nie musisz nic robić. Jeśli nie rozpoznajesz tej aktywności, natychmiast zabezpiecz konto.</p>
<p style="margin:0">
  <a href="{{ baseUrl }}" style="display:inline-block;background:#EB4747;color:#ffffff;text-decoration:none;font-weight:600;padding:10px 20px;border-radius:8px;font-size:14px">Sprawdź bezpieczeństwo konta</a>
</p>
{% include '_footer.pl.html.liquid' %}
